# resfit coffee-like default config (loaded by run_train_residual_td3_isaaclab_hparams.sh)
#
# Usage:
#   CONFIG_FILE=/abs/path/to/this.env bash resfit/rl_finetuning/scripts/run_train_residual_td3_isaaclab_hparams.sh
#
# Notes:
# - Keep KEY=VALUE format (no `export` needed; the launcher exports after loading).
# - Empty value means "use train config default" where applicable.

# -----------------------------------------------------------------------------
# Runtime / platform
# -----------------------------------------------------------------------------
HEADLESS=1
RUN_IN_DOCKER=1
DOCKER_CONTAINER=isaaclab_resfit
NUM_ENVS=1                    # env count (train/eval wrapper shared)
HEARTBEAT_INTERVAL_SEC=15     # launcher heartbeat period (sec)
STACK_DUMP_INTERVAL_SEC=0     # 0 disables periodic traceback dump
MAX_EPISODE_STEPS=1000        # per-episode step cap (reset at 1000)

# -----------------------------------------------------------------------------
# Data / model
# -----------------------------------------------------------------------------
CSV_BASE_DIR=/home/t-kinamkim/Repos/VLA_RL/Data/pickMushroom/pickMushroom_20251209_101454_058
GROOT_MODEL_PATH=/home/t-kinamkim/Repos/VLA_RL/Isaac-GR00T/outputs/pickMushroom_train/checkpoint-100000
LANGUAGE_OVERRIDE="pick up mushroom"

# -----------------------------------------------------------------------------
# Core training (coffee-like)
# -----------------------------------------------------------------------------
TOTAL_TIMESTEPS=500000
LEARNING_STARTS=10000
CRITIC_WARMUP_STEPS=10000
UPDATE_EVERY_N_STEPS=1
NUM_UPDATES_PER_ITERATION=4

OFFLINE_FRACTION=0.5
BATCH_SIZE=256
BUFFER_SIZE=200000
GAMMA=0.99
N_STEP=3
STDDEV_MAX=0.05
STDDEV_MIN=0.05
ACTOR_LR=1e-6
ACTION_SCALE=0.1
RANDOM_ACTION_NOISE_SCALE=0.2

# -----------------------------------------------------------------------------
# W&B
# -----------------------------------------------------------------------------
WANDB_MODE=online
WANDB_PROJECT=draftrec
WANDB_ENTITY=kkn18
WANDB_NAME=resfit-isaacsim
WANDB_GROUP=resfit
WANDB_NOTES=
WANDB_CONTINUE_RUN_ID=
WANDB_LOG_EVERY_STEPS=100
WANDB_API_KEY_FILE=/home/t-kinamkim/Keys/wandb_token

# -----------------------------------------------------------------------------
# Evaluation
# -----------------------------------------------------------------------------
# original resfit defaults (RLPD/ResidualTD3): interval=10000, eval_first=True, save_video=True
EVAL_INTERVAL_EVERY_STEPS=1000
EVAL_NUM_EPISODES=1
EVAL_FIRST=1
SAVE_VIDEO=1
OUTPUT_DIR=

# -----------------------------------------------------------------------------
# Optional tunables supported by runner (normally unused in coffee preset)
# -----------------------------------------------------------------------------
# task/policy routing
# TASK_DESCRIPTION=
# GROOT_EMBODIMENT_TAG=new_embodiment
# GROOT_POLICY_DEVICE=
# GROOT_POLICY_STRICT=0
# GR00T_HOST=127.0.0.1
# GR00T_PORT=5555

# launcher/runtime behavior
# ALLOW_CONCURRENT_TRAIN=0
# LOG_DIR=
# LOG_FILE=
# PYTHONPATH=
# ISO_DEPS_DIR=
# DOCKER_ISO_DEPS_DIR=/workspace/isaaclab/workspace/.pydeps_resfit_train
# GROOT_ISO_DEPS_DIR=
# DOCKER_GROOT_ISO_DEPS_DIR=/workspace/isaaclab/workspace/.pydeps_groot_iso
# USE_GROOT_ISO_DEPS=0

# convenience profile switch (used by hparams launcher)
# SMOKE=0
