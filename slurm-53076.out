Critic(
  (q_ensemble): SpatialEmbQEnsemble(
    heads: 10, weight: nn.Parameter (torch.Size([1, 128, 1024]))
    (input_proj): Sequential(
      (0): Linear(in_features=189, out_features=1024, bias=True)
      (1): LayerNorm((1024,), eps=1e-05, elementwise_affine=True)
      (2): ReLU(inplace=True)
    )
